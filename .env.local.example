# Copia este archivo como  .env.local  y pega los valores de tu proyecto de Firebase
# (Configuración del proyecto → Tus apps → App web → firebaseConfig).
# Estas mismas 5 variables se agregan en Vercel → Settings → Environment Variables.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
